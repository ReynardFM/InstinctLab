{
  "name": "evolution-lab",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "watch": "node scripts/build.ts --watch",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc -p .",
    "check": "tsc -p . && node --test \"test/*.test.ts\" && node scripts/check-dist.ts",
    "lab": "node src/cli/run.ts",
    "bench": "node src/cli/bench.ts",
    "bench-split": "node src/cli/split-bench.ts",
    "record-golden": "node scripts/record-golden.ts",
    "queue-demo": "node scripts/queue-demo.ts",
    "queue-status": "node scripts/queue-status.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@redis/client": "5.12.1"
  }
}
